{
  "name": "www.ovl.design",
  "version": "11.1.0",
  "type": "module",
  "description": "My homepage",
  "main": "eleventy.config.ts",
  "scripts": {
    "build": "ELEVENTY_ENV=production eleventy",
    "build:clean": "npm run clean && npm run build",
    "build:debug": "npm run build --debug",
    "clean": "rimraf dist",
    "lint": "concurrently \"npm:lint:*\"",
    "lint:css": "stylelint '**/*.pcss' --fix",
    "lint:js": "eslint \"**/*.{js,mjs}\" --ignore-pattern 'node_modules/**/*' --fix",
    "new:post": "node _helper/new-post.js",
    "serve": "ELEVENTY_ENV=development eleventy --serve --quiet --incremental --port 7777",
    "test": "ava",
    "ts": "tsc --build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ovlb/www.ovl.design.git"
  },
  "author": "ovl",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ovlb/www.ovl.design/issues"
  },
  "homepage": "https://github.com/ovlb/www.ovl.design#readme",
  "devDependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@inframanufaktur/eleventy-plugin-clean-urls": "^1.0.2",
    "@inframanufaktur/eleventy-plugin-embed-mastodon": "^0.6.0",
    "@quasibit/eleventy-plugin-sitemap": "^2.2.0",
    "@types/node": "^24.13.4",
    "autoprefixer": "^10.5.6",
    "ava": "^8.0.1",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "contentful": "^11.12.10",
    "csso": "^5.0.5",
    "del": "^8.0.1",
    "dotenv": "^17.4.2",
    "eleventy-plugin-embed-tweet": "^0.3.3",
    "eleventy-plugin-webmentions": "^2.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "feed": "^6.0.0",
    "globals": "^17.12.0",
    "html-minifier": "^4.0.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.5.1",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attribution": "^0.1.4",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-prism": "^4.0.0",
    "netlify-plugin-11ty": "^1.5.0",
    "open-props": "^1.7.23",
    "postcss": "^8.5.28",
    "postcss-custom-media": "^12.0.1",
    "postcss-import": "^17.0.0",
    "postcss-jit-props": "^1.0.16",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^8.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2"
  },
  "lint-staged": {
    "**/*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "_src/**/*.(p)?css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@netlify/functions": "^6.0.0",
    "esbuild": "^0.28.2",
    "lodash": "^4.18.1",
    "simple-git": "^3.36.0",
    "textics": "^1.2.0"
  },
  "overrides": {
    "sharp": "^0.33.5"
  }
}
